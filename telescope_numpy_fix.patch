-    def estep(self, pi, theta):
-        """ Calculate the expected values of z
-                E(z[i,j]) = ( pi[j] * theta[j]**Y[i] * Q[i,j] ) /
-        """
-        lg.debug('started e-step')
-
-        # New way:
-        # _n = self.Q.copy()
-        # _rowiter = zip(_n.indptr[:-1], _n.indptr[1:], self.Y[:, 0])
-        # for d_start, d_end, indicator in _rowiter:
