-        #     else:
-        #         _n.data[d_start:d_end] *= pi[_cidx]
-        # Newer way
-        _amb = csr_matrix(self.Q.multiply(self.Y)).multiply(pi * theta)
-        _uni = csr_matrix(self.Q.multiply(1 - self.Y)).multiply(pi)
